# ==============================================================================
# Delivery Time Prediction - Environment Configuration Template
# Copy this file to '.env' to customize local or containerized runtime settings.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Database & Model Artifacts
DATABASE_PATH=data/delivery_platform.db
MODEL_PATH=models/delivery_time_pipeline.joblib

# Security & API Credentials
API_SECRET_KEY=your_production_secret_key_here
ADMIN_API_KEY=your_admin_api_key_here

# Routing & Geocoding Providers
OSRM_ROUTING_URL=https://router.project-osrm.org
NOMINATIM_USER_AGENT=DeliveryTimePlatform/1.0 (contact: admin@deliveryml.local)
